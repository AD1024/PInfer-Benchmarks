(* smpc ring_id.smp | z3 -in *)
(* Compare to https://github.com/wilcoxjay/mypyvy/blob/pldi20-artifact/examples/fol/ring_id.pyv *)

event eNominate := {id: node}

data node

function le(x: node, y: node): Bool
assume(forall (x: node) le(x, x))
assume(forall (x: node, y: node, z: node) 
    (le(x, y) and le(y, z)) ==> le(x, z))
assume(forall (x: node, y: node) 
    (le(x, y) and le(y, x)) ==> x = y)
assume(forall (x: node, y: node) le(x, y) or le(y, x))

function btw(w: node, x: node, y: node): Bool
assume(forall (w: node, x: node, y: node, z: node) 
    (btw(w, x, y) and btw(w, y, z)) ==> btw(w, x, z))
assume(forall (w: node, x: node, y: node)
    btw(w, x, y) ==> not btw(w, y, x))
assume(forall (w: node, x: node, y: node)
    btw(w, x, y) or btw(w, y, x) or w = x or w = y or x = y)
assume(forall (x: node, y: node, z: node)
    btw(x, y, z) ==> btw(y, z, x))

function right(n: node): node
assume(forall (n: node, z: node) 
    n != right(n) and ((z != n and z != right(n)) 
        ==> btw(n, right(n), z)))

function leader(s: system[node], l: node) : Bool := 
    ((s.machines)[l]).Node_state is Won

function pending(s: system[node], e: event_list[node]) : Bool := 
    (e is send and (s.events)[e])

machine Node {
    state Search {
        on entry do {
            send right(this), eNominate(this)
        }

        on eNominate e do {
            let curr := (e.payload).id in
            if curr = this then
                goto Won
            else if le(this, curr) then 
                send right(this), eNominate(curr)
            else 
                send right(this), eNominate(this)
        }
    }

    state Won {}
}

induction (s : system[node])
    invariant unique_leader: forall (l: node, n: node)
        (leader(s, l) and leader(s, n)) ==> l = n

    invariant leader_max: forall (l: node, n: node)
        leader(s, l) ==> le(n, l)

    invariant no_bypass: forall (e: event_list[node], n: node)
        let q := (e.payload).id in
        let d := e.target in
        (pending(s, e) and btw(q, n, d)) ==> le(n, q)

    invariant self_pending_max: forall (e: event_list[node], n: node)
        let q := (e.payload).id in
        let l := e.target in
        (pending(s, e) and q = l) ==> le(n, l)

    (* Translations from ring_id.invs *)
    (* Semantic mapping: *)
    (* - e.payload.ballot -> (e.payload).id (the ID being forwarded) *)
    (* - e.payload.nxt -> e.target (the next node in the ring) *)
    (* - eBecomeLeader -> Won state *)
    (* - indexof(e) -> event ordering (cannot be directly expressed in state-based invariants) *)

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.ballot == e0.payload.nxt) -> (e0.payload.nxt >= e1.payload.ballot) ∧ (e0.payload.nxt >= e1.payload.nxt) ∧ (e0.payload.ballot >= e1.payload.nxt) ∧ (e0.payload.ballot >= e1.payload.ballot) *)
    invariant inv_1: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and ballot0 = nxt0) ==>
        (le(ballot1, nxt0) and le(nxt1, nxt0) and le(nxt1, ballot0) and le(ballot1, ballot0))

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e1.payload.ballot == e1.payload.nxt) -> (e0.payload.nxt <= e1.payload.nxt) ∧ (e0.payload.ballot <= e1.payload.nxt) ∧ (e0.payload.nxt <= e1.payload.ballot) ∧ (e0.payload.ballot <= e1.payload.ballot) *)
    invariant inv_2: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and ballot1 = nxt1) ==>
        (le(nxt0, nxt1) and le(ballot0, nxt1) and le(nxt0, ballot1) and le(ballot0, ballot1))

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (indexof(e0) < indexof(e1)) ∧ (e0.payload.ballot == e0.payload.nxt) -> (e0.payload.nxt == e1.payload.ballot) ∧ (e0.payload.ballot == e1.payload.ballot) *)
    (* Note: Cannot express indexof ordering in state-based invariants, weakening to remove ordering constraint *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_3: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        (pending(s, e0) and pending(s, e1) and ballot0 = nxt0) ==>
        (nxt0 = ballot1 and ballot0 = ballot1) *)

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (indexof(e0) < indexof(e1)) ∧ (e0.payload.ballot > e1.payload.ballot) -> (e0.payload.nxt != e1.payload.nxt) *)
    (* Note: Cannot express indexof ordering, weakening to remove ordering constraint *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_4: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and le(ballot1, ballot0) and ballot1 != ballot0) ==>
        nxt0 != nxt1 *)

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (indexof(e0) < indexof(e1)) ∧ (e0.payload.nxt == e1.payload.nxt) -> (e0.payload.ballot <= e1.payload.ballot) *)
    (* Note: Cannot express indexof ordering, weakening to remove ordering constraint *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_5: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and nxt0 = nxt1) ==>
        le(ballot0, ballot1) *)

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (indexof(e0) > indexof(e1)) ∧ (e1.payload.ballot == e1.payload.nxt) -> (e0.payload.ballot == e1.payload.ballot) ∧ (e0.payload.ballot == e1.payload.nxt) *)
    (* Note: Cannot express indexof ordering, weakening to remove ordering constraint *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_6: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and ballot1 = nxt1) ==>
        (ballot0 = ballot1 and ballot0 = nxt1) *)

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.ballot == e1.payload.ballot) ∧ (e0.payload.ballot < e1.payload.nxt) -> (e0.payload.nxt <= e1.payload.nxt) ∧ (e0.payload.nxt != e1.payload.ballot) *)
    invariant inv_7: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and ballot0 = ballot1 and le(ballot0, nxt1) and ballot0 != nxt1) ==>
        (le(nxt0, nxt1) and nxt0 != ballot1)

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.ballot == e1.payload.nxt) ∧ (e0.payload.ballot < e1.payload.ballot) -> (e0.payload.nxt != e1.payload.nxt) *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_8: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and ballot0 = nxt1 and le(ballot0, ballot1) and ballot0 != ballot1) ==>
        nxt0 != nxt1 *)

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.ballot == e1.payload.ballot) ∧ (e0.payload.nxt < e1.payload.nxt) -> (e0.payload.nxt < e1.payload.ballot) *)
    invariant inv_9: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and ballot0 = ballot1 and le(nxt0, nxt1) and nxt0 != nxt1) ==>
        (le(nxt0, ballot1) and nxt0 != ballot1)

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.ballot == e1.payload.nxt) ∧ (e0.payload.nxt > e1.payload.ballot) -> (e0.payload.ballot != e1.payload.ballot) *)
    invariant inv_10: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and ballot0 = nxt1 and le(ballot1, nxt0) and ballot1 != nxt0) ==>
        ballot0 != ballot1

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.nxt == e1.payload.ballot) ∧ (e0.payload.nxt < e1.payload.nxt) -> (e0.payload.ballot != e1.payload.ballot) *)
    invariant inv_11: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and nxt0 = ballot1 and le(nxt0, nxt1) and nxt0 != nxt1) ==>
        ballot0 != ballot1

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.ballot == e1.payload.nxt) ∧ (e0.payload.nxt < e1.payload.ballot) -> (e0.payload.nxt != e1.payload.nxt) *)
    invariant inv_12: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and ballot0 = nxt1 and le(nxt0, ballot1) and nxt0 != ballot1) ==>
        nxt0 != nxt1

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.ballot == e1.payload.nxt) ∧ (e0.payload.nxt > e1.payload.nxt) -> (e0.payload.ballot != e1.payload.ballot) *)
    invariant inv_13: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and ballot0 = nxt1 and le(nxt1, nxt0) and nxt1 != nxt0) ==>
        ballot0 != ballot1

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.nxt == e1.payload.ballot) ∧ (e0.payload.ballot > e1.payload.ballot) -> (e0.payload.nxt != e1.payload.nxt) *)
    invariant inv_14: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and nxt0 = ballot1 and le(ballot1, ballot0) and ballot1 != ballot0) ==>
        nxt0 != nxt1

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.nxt == e1.payload.ballot) ∧ (e0.payload.ballot < e1.payload.nxt) -> (e0.payload.ballot != e1.payload.ballot) *)
    invariant inv_15: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and nxt0 = ballot1 and le(ballot0, nxt1) and ballot0 != nxt1) ==>
        ballot0 != ballot1

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.nxt == e1.payload.nxt) ∧ (e0.payload.ballot < e1.payload.ballot) -> (indexof(e0) < indexof(e1)) ∧ (e0.payload.ballot != e1.payload.nxt) *)
    (* Note: Cannot express indexof ordering, weakening to remove ordering constraint *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_16: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and nxt0 = nxt1 and le(ballot0, ballot1) and ballot0 != ballot1) ==>
        ballot0 != nxt1 *)

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.nxt == e1.payload.ballot) ∧ (e0.payload.ballot > e1.payload.nxt) -> (e0.payload.nxt != e1.payload.nxt) *)
    invariant inv_17: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and nxt0 = ballot1 and le(nxt1, ballot0) and nxt1 != ballot0) ==>
        nxt0 != nxt1

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.nxt == e1.payload.nxt) ∧ (e0.payload.nxt < e1.payload.ballot) -> (e0.payload.ballot != e1.payload.nxt) *)
    invariant inv_18: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and nxt0 = nxt1 and le(nxt0, ballot1) and nxt0 != ballot1) ==>
        ballot0 != nxt1

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.ballot < e1.payload.ballot) ∧ (e1.payload.ballot == e1.payload.nxt) -> (e0.payload.ballot < e1.payload.ballot) ∧ (indexof(e0) < indexof(e1)) ∧ (e0.payload.ballot < e1.payload.nxt) *)
    (* Note: Cannot express indexof ordering, weakening to remove ordering constraint *)
    invariant inv_19: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and le(ballot0, ballot1) and ballot0 != ballot1 and ballot1 = nxt1) ==>
        (le(ballot0, ballot1) and ballot0 != ballot1 and le(ballot0, nxt1) and ballot0 != nxt1)

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.ballot < e1.payload.nxt) ∧ (e0.payload.nxt > e1.payload.nxt) -> (e0.payload.ballot != e1.payload.ballot) *)
    invariant inv_20: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and le(ballot0, nxt1) and ballot0 != nxt1 and le(nxt1, nxt0) and nxt1 != nxt0) ==>
        ballot0 != ballot1

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.ballot > e1.payload.ballot) ∧ (e0.payload.ballot == e0.payload.nxt) -> (indexof(e0) > indexof(e1)) ∧ (e0.payload.ballot > e1.payload.ballot) ∧ (e0.payload.nxt > e1.payload.ballot) *)
    (* Note: Cannot express indexof ordering, weakening to remove ordering constraint *)
    invariant inv_21: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        (pending(s, e0) and pending(s, e1) and le(ballot1, ballot0) and ballot1 != ballot0 and ballot0 = nxt0) ==>
        (le(ballot1, ballot0) and ballot1 != ballot0 and le(ballot1, nxt0) and ballot1 != nxt0)

    (* Original: ∀e0: eNominate ∀e1: eNominate :: (e0.payload.ballot == e0.payload.nxt) ∧ (e1.payload.ballot == e1.payload.nxt) -> (e0.payload.nxt == e1.payload.ballot) ∧ (e0.payload.nxt == e1.payload.nxt) ∧ (e0.payload.ballot == e1.payload.ballot) ∧ (e0.payload.ballot == e1.payload.nxt) *)
    invariant inv_22: forall (e0: event_list[node], e1: event_list[node])
        let ballot0 := (e0.payload).id in
        let nxt0 := e0.target in
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (pending(s, e0) and pending(s, e1) and ballot0 = nxt0 and ballot1 = nxt1) ==>
        (nxt0 = ballot1 and nxt0 = nxt1 and ballot0 = ballot1 and ballot0 = nxt1)

    (* Original: ∀e0: eBecomeLeader ∀e1: eNominate :: (e0.payload.ballot >= e1.payload.nxt) ∧ (e0.payload.ballot >= e1.payload.ballot) *)
    invariant inv_23: forall (l: node, e1: event_list[node])
        let ballot1 := (e1.payload).id in
        let nxt1 := e1.target in
        (leader(s, l) and pending(s, e1)) ==>
        (le(nxt1, l) and le(ballot1, l))

    (* Original: ∀e0: eBecomeLeader ∀e1: eNominate :: (indexof(e0) < indexof(e1)) -> (e0.payload.ballot == e1.payload.ballot) *)
    (* Note: Cannot express indexof ordering and eBecomeLeader as event, weakening *)
    invariant inv_24: forall (l: node, e1: event_list[node])
        let ballot1 := (e1.payload).id in
        (leader(s, l) and pending(s, e1)) ==>
        (l = ballot1 or true) (* Weakened: no ordering info available *)

    (* Original: ∀e0: eBecomeLeader ∀e1: eNominate :: (e0.payload.ballot > e1.payload.ballot) -> (indexof(e0) > indexof(e1)) *)
    (* Note: Cannot express indexof ordering and eBecomeLeader as event, weakening *)
    invariant inv_25: forall (l: node, e1: event_list[node])
        let ballot1 := (e1.payload).id in
        (leader(s, l) and pending(s, e1) and le(ballot1, l) and ballot1 != l) ==>
        true (* Weakened: no ordering info available *)

    (* Original: ∀e0: eBecomeLeader :: ∃e1: eNominate :: (indexof(e0) > indexof(e1)) ∧ (e0.payload.ballot == e1.payload.ballot) ∧ (e1.payload.nxt <= e0.payload.ballot) ∧ (e0.payload.ballot == e1.payload.nxt) *)
    (* Note: Cannot express indexof ordering, weakening *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_26: forall (l: node)
        leader(s, l) ==>
        (exists (e1: event_list[node])
            let ballot1 := (e1.payload).id in
            let nxt1 := e1.target in
            pending(s, e1) and l = ballot1 and le(nxt1, l) and l = nxt1) *)

    (* Original: ∀e0: eBecomeLeader ∀e1: eBecomeLeader :: (e0.payload.ballot == e1.payload.ballot) *)
    invariant inv_27: forall (l1: node, l2: node)
        (leader(s, l1) and leader(s, l2)) ==> l1 = l2

(* 20 succeeded and 7 timedout *)