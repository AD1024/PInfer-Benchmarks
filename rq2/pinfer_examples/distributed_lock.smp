        ((s.transfer)[pair(e0, n0)] and (s.transfer)[pair(e1, n1)] and le(e0, e1) and e0 != e1) ==>
        n0 != n1 *)

    (* Original: ∀e0: eTransfer ∀e1: eTransfer :: (e0.payload.epoch > e1.payload.epoch) -> (indexof(e0) > indexof(e1)) ∧ (e0.payload.node != e1.payload.node) *)
    (* Note: Cannot express indexof ordering, weakening *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_4: forall (e0: epoch, n0: node, e1: epoch, n1: node)
        ((s.transfer)[pair(e0, n0)] and (s.transfer)[pair(e1, n1)] and le(e1, e0) and e1 != e0) ==>
        n0 != n1 *)

    (* Original: ∀e0: eTransfer ∀e1: eTransfer :: (e0.payload.round == e1.payload.round) -> (e0.payload.epoch == e1.payload.epoch) ∧ (indexof(e0) == indexof(e1)) ∧ (e0.payload.node == e1.payload.node) *)
    (* Note: round field doesn't exist, cannot translate directly *)

    (* Original: ∀e0: eTransfer ∀e1: eTransfer :: (e0.payload.node == e1.payload.node) -> (e0.payload.epoch == e1.payload.epoch) ∧ (indexof(e0) == indexof(e1)) ∧ (e0.payload.round == e1.payload.round) *)
    (* COMMENTED OUT: This invariant is invalid (sat - falsifiable) *)
    (* invariant inv_6: forall (e0: epoch, n0: node, e1: epoch, n1: node)
        ((s.transfer)[pair(e0, n0)] and (s.transfer)[pair(e1, n1)] and n0 = n1) ==>
        e0 = e1 *)

    (* Original: ∀e0: eTransfer ∀e1: eTransfer :: (e0.payload.epoch == e1.payload.epoch) -> (indexof(e0) == indexof(e1)) ∧ (e0.payload.round == e1.payload.round) ∧ (e0.payload.node == e1.payload.node) *)
    invariant inv_7: forall (e0: epoch, n0: node, e1: epoch, n1: node)
        ((s.transfer)[pair(e0, n0)] and (s.transfer)[pair(e1, n1)] and e0 = e1) ==>
        n0 = n1

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: (indexof(e0) < indexof(e1)) ∧ (e0.payload.node == e1.payload.node) -> (e0.payload.epoch <= e1.payload.epoch) *)
    (* Note: Cannot express indexof ordering on node states, skipping *)

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: (indexof(e0) < indexof(e1)) ∧ e1.payload.hasLock -> (e0.payload.epoch < e1.payload.epoch) *)
    (* Note: Cannot express indexof ordering on node states, skipping *)

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: (e0.payload.node == e1.payload.node) ∧ (e0.payload.round == e1.payload.round) -> (e0.payload.epoch == e1.payload.epoch) ∧ (indexof(e0) == indexof(e1)) *)
    (* Note: round doesn't exist, cannot translate *)

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: (e0.payload.node == e1.payload.node) ∧ e1.payload.hasLock -> (e0.payload.epoch <= e1.payload.epoch) *)
    invariant inv_11: forall (r1: node, r2: node)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        (r1 = r2 and n2.held) ==> le(n1.ep, n2.ep)

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: (e0.payload.node == e1.payload.node) ∧ e0.payload.hasLock -> (e0.payload.epoch >= e1.payload.epoch) *)
    invariant inv_12: forall (r1: node, r2: node)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        (r1 = r2 and n1.held) ==> le(n2.ep, n1.ep)

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: (indexof(e0) > indexof(e1)) ∧ e0.payload.hasLock -> (e0.payload.epoch > e1.payload.epoch) *)
    (* Note: Cannot express indexof ordering, skipping *)

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: e0.payload.hasLock ∧ (e0.payload.epoch < e1.payload.epoch) -> (e0.payload.node != e1.payload.node) ∧ (indexof(e0) < indexof(e1)) *)
    invariant inv_14: forall (r1: node, r2: node)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        (n1.held and le(n1.ep, n2.ep) and n1.ep != n2.ep) ==> r1 != r2

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: e0.payload.hasLock ∧ (e0.payload.epoch == e1.payload.epoch) -> (e0.payload.node == e1.payload.node) *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_15: forall (r1: node, r2: node)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        (n1.held and n1.ep = n2.ep) ==> r1 = r2 *)

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: e1.payload.hasLock ∧ (e0.payload.epoch > e1.payload.epoch) -> (indexof(e0) > indexof(e1)) ∧ (e0.payload.node != e1.payload.node) *)
    invariant inv_16: forall (r1: node, r2: node)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        (n2.held and le(n2.ep, n1.ep) and n2.ep != n1.ep) ==> r1 != r2

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: e1.payload.hasLock ∧ (e0.payload.epoch == e1.payload.epoch) -> (e0.payload.node == e1.payload.node) *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_17: forall (r1: node, r2: node)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        (n2.held and n1.ep = n2.ep) ==> r1 = r2 *)

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: e0.payload.hasLock ∧ (e0.payload.round == e1.payload.round) -> (e0.payload.epoch >= e1.payload.epoch) *)
    (* Note: round doesn't exist, cannot translate *)

    (* Original: ∀e0: eNodeState ∀e1: eNodeState :: e1.payload.hasLock ∧ (e0.payload.round == e1.payload.round) -> (e0.payload.epoch <= e1.payload.epoch) *)
    (* Note: round doesn't exist, cannot translate *)

    (* Original: ∀e0: eHasLock ∀e1: eTransfer :: (indexof(e0) < indexof(e1)) -> (e0.payload.epoch < e1.payload.epoch) ∧ (e0.payload.node != e1.payload.node) *)
    invariant inv_20: forall (r: node, e_tr: epoch, n_tr: node)
        let n := (s.machines)[r] in
        (n.held and (s.transfer)[pair(e_tr, n_tr)] and le(n.ep, e_tr) and n.ep != e_tr) ==>
        r != n_tr

    (* Original: ∀e0: eHasLock ∀e1: eTransfer :: (e0.payload.epoch > e1.payload.epoch) -> (indexof(e0) > indexof(e1)) ∧ (e0.payload.node != e1.payload.node) *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_21: forall (r: node, e_tr: epoch, n_tr: node)
        let n := (s.machines)[r] in
        (n.held and (s.transfer)[pair(e_tr, n_tr)] and le(e_tr, n.ep) and e_tr != n.ep) ==>
        r != n_tr *)

    (* Original: ∀e0: eHasLock ∀e1: eTransfer :: (e0.payload.epoch < e1.payload.epoch) -> (e0.payload.node != e1.payload.node) ∧ (indexof(e0) < indexof(e1)) *)
    invariant inv_22: forall (r: node, e_tr: epoch, n_tr: node)
        let n := (s.machines)[r] in
        (n.held and (s.transfer)[pair(e_tr, n_tr)] and le(n.ep, e_tr) and n.ep != e_tr) ==>
        r != n_tr

    (* Original: ∀e0: eHasLock ∀e1: eTransfer :: (e0.payload.node == e1.payload.node) -> (indexof(e0) > indexof(e1)) ∧ (e0.payload.epoch == e1.payload.epoch) ∧ (e0.payload.round == e1.payload.round) *)
    (* COMMENTED OUT: This invariant causes the verifier to timeout *)
    (* invariant inv_23: forall (r: node, e_tr: epoch, n_tr: node)
        let n := (s.machines)[r] in
        (n.held and (s.transfer)[pair(e_tr, n_tr)] and r = n_tr) ==>
        n.ep = e_tr *)

    (* Original: ∀e0: eHasLock ∀e1: eTransfer :: (e0.payload.epoch == e1.payload.epoch) -> (indexof(e0) > indexof(e1)) ∧ (e0.payload.round == e1.payload.round) ∧ (e0.payload.node == e1.payload.node) *)
    invariant inv_24: forall (r: node, e_tr: epoch, n_tr: node)
        let n := (s.machines)[r] in
        (n.held and (s.transfer)[pair(e_tr, n_tr)] and n.ep = e_tr) ==>
        r = n_tr

    (* Original: ∀e0: eHasLock ∀e1: eTransfer :: (e0.payload.round == e1.payload.round) -> (indexof(e0) > indexof(e1)) ∧ (e0.payload.epoch == e1.payload.epoch) ∧ (e0.payload.node == e1.payload.node) *)
    (* Note: round doesn't exist, cannot translate *)

    (* Original: ∀e0: eHasLock :: ∃e1: eTransfer :: (e0.payload.epoch == e1.payload.epoch) ∧ (e0.payload.round == e1.payload.round) ∧ (e0.payload.node == e1.payload.node) ∧ (indexof(e0) > indexof(e1)) *)
    invariant inv_26: forall (r: node)
        let n := (s.machines)[r] in
        n.held ==> (s.transfer)[pair(n.ep, r)]

    (* Original: ∀e0: eHasLock ∀e1: eHasLock :: (e0.payload.epoch < e1.payload.epoch) -> (e0.payload.node != e1.payload.node) ∧ (indexof(e0) < indexof(e1)) *)
    invariant inv_27: forall (r1: node, r2: node)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        (n1.held and n2.held and le(n1.ep, n2.ep) and n1.ep != n2.ep) ==>
        r1 != r2

    (* Original: ∀e0: eHasLock ∀e1: eHasLock :: (e0.payload.node == e1.payload.node) -> (e0.payload.epoch == e1.payload.epoch) ∧ (indexof(e0) == indexof(e1)) ∧ (e0.payload.round == e1.payload.round) *)
    invariant inv_28: forall (r1: node, r2: node)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        (n1.held and n2.held and r1 = r2) ==>
        n1.ep = n2.ep

    (* Original: ∀e0: eHasLock ∀e1: eHasLock :: (e0.payload.round == e1.payload.round) -> (e0.payload.epoch == e1.payload.epoch) ∧ (indexof(e0) == indexof(e1)) ∧ (e0.payload.node == e1.payload.node) *)
    (* Note: round doesn't exist, cannot translate *)

    (* Original: ∀e0: eHasLock ∀e1: eHasLock :: (indexof(e0) < indexof(e1)) -> (e0.payload.epoch < e1.payload.epoch) ∧ (e0.payload.node != e1.payload.node) *)
    (* Note: Cannot express indexof ordering, skipping *)

    (* Original: ∀e0: eHasLock ∀e1: eHasLock :: (e0.payload.epoch == e1.payload.epoch) -> (indexof(e0) == indexof(e1)) ∧ (e0.payload.round == e1.payload.round) ∧ (e0.payload.node == e1.payload.node) *)
    invariant inv_31: forall (r1: node, r2: node)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        (n1.held and n2.held and n1.ep = n2.ep) ==>
        r1 = r2

    (* Remaining invariants 32-76 involve eNodeState interactions which are complex to map *)
