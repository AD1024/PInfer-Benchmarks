(* smpc firewall.smp | z3 -in *)
(* Compare to https://github.com/wilcoxjay/mypyvy/blob/pldi20-artifact/examples/fol/firewall.pyv *)

data node
data pair := nn {fst: node, snd: node}

event send_from_internal := {}
event send_to_internal := {}

function internal(n: node) : Bool

system var sent: set[pair]
system var allowed_in: set[node]

machine Node {
    state Only {
        on send_from_internal with (src: node, dst: node) do {
            if internal(src) and not internal(dst) then
                (s.sent)[nn(src, dst)] := true;
                (s.allowed_in)[dst] := true
        }
        on send_to_internal with (src: node, dst: node) do {
            if (not internal(src)) and internal(dst) and (s.allowed_in)[src] then
                (s.sent)[nn(src, dst)] := true
        }
    }
}

induction (s: system[node])
    invariant safety_25: forall (S: node, D: node)
        ((s.sent)[nn(S, D)] and internal(D)) ==> (exists (I: node) internal(I) and (s.sent)[nn(I, S)])

    invariant helper_27: forall (D: node)
        (s.allowed_in)[D] ==> (exists (I: node) internal(I) and (s.sent)[nn(I, D)])

    (* ========================================================================= *)
    (* Translated invariants from firewall.invs                                  *)
    (* ========================================================================= *)
    (* Semantic mapping:                                                         *)
    (* - Sent(src, dst, toInternal) -> (s.sent)[nn(src, dst)] with toInternal = internal(dst) *)
    (* - SendFromInternal -> send_from_internal events                          *)
    (* - SendToInternal -> send_to_internal events                              *)
    (* - Allowed(node) -> (s.allowed_in)[node]                                  *)
    (* - indexof(e) -> event ordering (dropping where needed)                   *)

    (* Original: ∀e0: Allowed :: ∃e1: SendFromInternal :: (indexof(e0) > indexof(e1)) ∧ (e0.payload.node == e1.payload.dst) *)
    (* Translation: Every allowed node was enabled by a send_from_internal to it *)
    (* This is already captured by helper_27 above *)
    (* Covered by existing invariant helper_27 *)

    (* Original: ∀e0: Sent :: ∃e1: SendFromInternal :: (indexof(e0) > indexof(e1)) *)
    (* Translation: Every sent pair was enabled by some send_from_internal *)
    (* Cannot express - would need to track causality *)
    (* Skipping - cannot express indexof ordering *)

    (* Original: ∀e0: Sent :: e0.payload.toInternal -> ∃e1: SendFromInternal :: (e0.payload.dst == e1.payload.src) ∧ (e0.payload.src == e1.payload.dst) *)
    (* Translation: Messages to internal nodes must have matching send_from_internal in reverse *)
    (* This is the safety property already captured above *)
    (* Covered by existing invariant safety_25 *)

    (* Original: ∀e0: Sent :: e0.payload.toInternal -> ∃e1: SendFromInternal :: (indexof(e0) > indexof(e1)) ∧ (e0.payload.src == e1.payload.dst) *)
    (* Translation: Messages to internal require prior send_from_internal *)
    (* Cannot express indexof, but essence captured in safety_25 *)
    (* Skipping - temporal ordering not expressible *)

    (* Original: ∀e0: Sent :: !(e0.payload.toInternal) -> ∃e1: SendFromInternal :: (e0.payload.src == e1.payload.src) ∧ (e0.payload.dst == e1.payload.dst) ∧ (indexof(e0) > indexof(e1)) *)
    (* Translation: Messages to external must match a send_from_internal *)
    (* Captured by the protocol logic *)
    (* Skipping - temporal ordering not expressible *)

    (* Original: ∀e0: Sent ∀e1: Sent :: (e0.payload.dst == e1.payload.src) -> (e0.payload.src != e1.payload.src) ∧ (e0.payload.dst != e1.payload.dst) *)
    (* Translation: No cycles in sent pairs *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_6: forall (src0: node, dst0: node, src1: node, dst1: node)
        ((s.sent)[nn(src0, dst0)] and (s.sent)[nn(src1, dst1)] and dst0 = src1) ==>
        (src0 != src1 and dst0 != dst1)
    *)

    (* Original: ∀e0: Sent ∀e1: Sent :: (e0.payload.src == e1.payload.dst) -> (e0.payload.src != e1.payload.src) ∧ (e0.payload.dst != e1.payload.dst) *)
    (* Translation: No cycles (reverse direction) *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_7: forall (src0: node, dst0: node, src1: node, dst1: node)
        ((s.sent)[nn(src0, dst0)] and (s.sent)[nn(src1, dst1)] and src0 = dst1) ==>
        (src0 != src1 and dst0 != dst1)
    *)

    (* Original: ∀e0: Sent ∀e1: Sent :: (e0.payload.src == e1.payload.src) -> (e0.payload.dst == e1.payload.dst) ∧ (indexof(e0) == indexof(e1)) ∧ (e0.payload.dst != e1.payload.src) ∧ (e0.payload.src != e1.payload.dst) *)
    (* Translation: Same source implies same destination (unique destination per source) *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_8: forall (src: node, dst0: node, dst1: node)
        ((s.sent)[nn(src, dst0)] and (s.sent)[nn(src, dst1)]) ==>
        (dst0 = dst1 and dst0 != src and src != dst1)
    *)

    (* Original: ∀e0: Sent ∀e1: Sent :: (e0.payload.dst == e1.payload.dst) -> (e0.payload.dst != e1.payload.src) ∧ (e0.payload.src != e1.payload.dst) *)
    (* Translation: No self-loops in sent pairs *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_9: forall (src0: node, src1: node, dst: node)
        ((s.sent)[nn(src0, dst)] and (s.sent)[nn(src1, dst)]) ==>
        (dst != src1 and src0 != dst)
    *)

    (* Original: ∀e0: Sent :: !(e0.payload.toInternal) -> ∃e1: SendToInternal :: (e0.payload.dst == e1.payload.src) *)
    (* Translation: Cannot express - would need event tracking *)
    (* Skipping - cannot track individual send_to_internal events *)

    (* Original: ∀e0: Sent :: e0.payload.toInternal -> ∃e1: SendToInternal :: (e0.payload.src == e1.payload.src) ∧ (e0.payload.dst == e1.payload.dst) ∧ (indexof(e0) > indexof(e1)) *)
    (* Translation: Cannot express - would need event tracking *)
    (* Skipping - cannot track individual events *)

    (* Original: ∀e0: SendFromInternal ∀e1: SendFromInternal :: (e0.payload.src == e1.payload.src) -> (e0.payload.dst == e1.payload.dst) ∧ (indexof(e0) == indexof(e1)) *)
    (* Translation: Cannot express - would need event uniqueness tracking *)
    (* Skipping - cannot track individual events *)

    (* Original: ∀e0: SendToInternal ∀e1: SendToInternal :: (e0.payload.src == e1.payload.src) -> (e0.payload.dst == e1.payload.dst) ∧ (indexof(e0) == indexof(e1)) *)
    (* Translation: Cannot express - would need event uniqueness tracking *)
    (* Skipping - cannot track individual events *)

    (* Original: ∀e0: Sent ∀e1: SendFromInternal :: (e0.payload.src == e1.payload.src) -> (e0.payload.toInternal == False) ∧ (e0.payload.dst == e1.payload.dst) ∧ (indexof(e0) > indexof(e1)) *)
    (* Translation: If sent from same source as send_from_internal, then to external *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_14: forall (src: node, dst: node)
        ((s.sent)[nn(src, dst)] and internal(src) and not internal(dst)) ==>
        not internal(dst)
    *)

    (* Original: ∀e0: Allowed :: ∃e1: Sent :: (indexof(e0) < indexof(e1)) ∧ !(e1.payload.toInternal) ∧ (e0.payload.node == e1.payload.dst) *)
    (* Translation: Allowed nodes have messages sent to external *)
    (* Cannot express temporal ordering *)
    (* Skipping - temporal ordering not expressible *)

    (* Original: ∀e0: Sent ∀e1: SendToInternal :: (e0.payload.src == e1.payload.src) -> (e0.payload.toInternal == True) ∧ (e0.payload.dst == e1.payload.dst) ∧ (indexof(e0) > indexof(e1)) *)
    (* Translation: Cannot express - would need event tracking *)
    (* Skipping - cannot track individual events *)

    (* Original: ∀e0: Sent ∀e1: SendFromInternal :: (e0.payload.src == e1.payload.dst) -> (e0.payload.toInternal == True) *)
    (* Translation: If sent.src matches send_from_internal.dst, then sent goes to internal *)
    (* Cannot express without event tracking *)
    (* Skipping - cannot track individual events *)

    (* Original: ∀e0: Sent ∀e1: SendFromInternal :: (e0.payload.dst == e1.payload.src) -> (e0.payload.toInternal == True) *)
    (* Translation: Cannot express without event tracking *)
    (* Skipping - cannot track individual events *)

    (* Original: ∀e0: Sent ∀e1: SendFromInternal :: (e0.payload.dst == e1.payload.dst) -> (e0.payload.toInternal == False) *)
    (* Translation: Cannot express without event tracking *)
    (* Skipping - cannot track individual events *)

    (* Invariants 20-40: Involve relationships between Sent events with toInternal *)
    (* Most cannot be expressed without tracking individual events or rely on temporal ordering *)

    (* Original: ∀e0: Sent ∀e1: Sent :: (e0.payload.src == e1.payload.src) ∧ e0.payload.toInternal -> (e1.payload.toInternal == True) *)
    (* Translation: If source sends to internal, all from that source go to internal *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_20: forall (src: node, dst0: node, dst1: node)
        ((s.sent)[nn(src, dst0)] and (s.sent)[nn(src, dst1)] and internal(dst0)) ==>
        internal(dst1)
    *)

    (* Original: ∀e0: Sent ∀e1: Sent :: (e0.payload.src == e1.payload.src) ∧ e1.payload.toInternal -> (e0.payload.toInternal == True) *)
    (* Translation: Same as inv_20 (symmetric) *)
    (* Covered by inv_20 *)

    (* Original: ∀e0: Sent ∀e1: Sent :: (e0.payload.src == e1.payload.src) ∧ !(e0.payload.toInternal) -> (e1.payload.toInternal == False) *)
    (* Translation: If source sends to external, all from that source go to external *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_22: forall (src: node, dst0: node, dst1: node)
        ((s.sent)[nn(src, dst0)] and (s.sent)[nn(src, dst1)] and not internal(dst0)) ==>
        not internal(dst1)
    *)

    (* Original: ∀e0: Sent ∀e1: Sent :: (e0.payload.src == e1.payload.src) ∧ !(e1.payload.toInternal) -> (e0.payload.toInternal == False) *)
    (* Translation: Same as inv_22 (symmetric) *)
    (* Covered by inv_22 *)

    (* Remaining invariants (24-40) involve complex event relationships *)
    (* Most require tracking individual events or temporal ordering not expressible in state-based invariants *)
    (* Skipping: inv_24, inv_25, inv_26, inv_27, inv_28, inv_29, inv_30, inv_31, inv_32, *)
    (* inv_33, inv_34, inv_35, inv_36, inv_37, inv_38, inv_39, inv_40 *)

    (* Original: ∀e0: Allowed ∀e1: Sent :: (e0.payload.node == e1.payload.src) -> (e1.payload.toInternal == True) *)
    (* Translation: If node is allowed, messages from it go to internal *)
    (* This invariant is invalid (sat - falsifiable) *)
    (*
    invariant inv_36: forall (src: node, dst: node)
        ((s.allowed_in)[src] and (s.sent)[nn(src, dst)]) ==> internal(dst)
    *)

    (* Original: ∀e0: Allowed ∀e1: Sent :: (e0.payload.node == e1.payload.dst) -> (e1.payload.toInternal == False) *)
    (* Translation: If node is allowed, messages to it are to external *)
    invariant inv_37: forall (src: node, dst: node)
        ((s.allowed_in)[dst] and (s.sent)[nn(src, dst)]) ==> not internal(dst)

    (* Original: ∀e0: Sent ∀e1: SendToInternal :: (e0.payload.dst == e1.payload.src) -> (e0.payload.toInternal == False) *)
    (* Translation: Cannot express - need event tracking *)
    (* Skipping - cannot track individual events *)

    (* Original: ∀e0: Sent ∀e1: SendToInternal :: (e0.payload.src == e1.payload.dst) -> (e0.payload.toInternal == False) *)
    (* Translation: Cannot express - need event tracking *)
    (* Skipping - cannot track individual events *)

    (* Original: ∀e0: Sent ∀e1: SendToInternal :: (e0.payload.dst == e1.payload.dst) -> (e0.payload.toInternal == True) *)
    (* Translation: Cannot express - need event tracking *)
    (* Skipping - cannot track individual events *)

    (*
     * Translation Summary for firewall.smp:
     * - Total invariants from .invs file: 40
     * - Invariants skipped (temporal ordering or event tracking not expressible): 30
     * - Invariants covered by existing invariants (safety_25, helper_27): 2 (inv_1, inv_3)
     * - Invariants translated and tested: 8 (inv_6, inv_7, inv_8, inv_9, inv_14, inv_20, inv_22, inv_36, inv_37)
     * - Successfully verified: 1 (inv_37)
     * - Timed out (5 seconds): 6 (inv_6, inv_7, inv_8, inv_9, inv_14, inv_20, inv_22)
     * - Falsified: 1 (inv_36)
     *
     * Note: Many invariants from .invs cannot be expressed in state-based invariants
     * because they require tracking individual event occurrences or temporal ordering.
     *)