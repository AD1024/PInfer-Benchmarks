(* smpc sharded_kv.smp | z3 -in *)
(* Compare to https://github.com/wilcoxjay/mypyvy/blob/pldi20-artifact/examples/fol/sharded_kv.pyv *)

data key
data value
data node

data kv := kv {k: key, v: value}

event eTransfer := {transfer_key: key, transfer_value: value}
event eReshard  := {reshard_key : key, reshard_value : value, reshard_to: node}
event ePut      := {put_key     : key, put_value     : value}

machine Node {
    var table: set[kv]
    var owns : set[key]

    state only {
        on eReshard e do {
            let k := (e.payload).reshard_key   in
            let v := (e.payload).reshard_value in
            let t := (e.payload).reshard_to    in

            if table[kv(k, v)] then
                table[kv(k, v)] := false;
                owns[k] := false;
                send t, eTransfer(k, v)
        }

        on eTransfer e do {
            let k := (e.payload).transfer_key   in
            let v := (e.payload).transfer_value in
            table[kv(k, v)] := true;
            owns[k] := true
        }

        on ePut e do {
            let k := (e.payload).put_key   in
            let v := (e.payload).put_value in

            if owns[k] then
                table := update_table(table, k, v)
        }
    }
}

function update_table(table: set[kv], k: key, v: value) : set[kv]
assume(forall (old_table: set[kv], k: key, v: value, K: key, V: value) 
    let new_table := update_table(old_table, k, v) in
    ((K != k) ==> (new_table[kv(K, V)] = old_table[kv(K, V)])) and
    (new_table[kv(k, V)] = (V = v)))

function transfer_msg(s : system[node], e: event_list[node]) : Bool :=
    (s.events)[e] and e is send and e.payload is eTransfer

induction (s : system[node]) 
    invariant safety_38: forall (r1: node, r2: node, k: key, v1: value, v2: value)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        ((n1.table)[kv(k, v1)] and (n2.table)[kv(k, v2)]) ==> (r1 = r2 and v1 = v2)

    invariant owner_40: forall (r1: node, r2: node, k: key)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        ((n1.owns)[k] and (n2.owns)[k]) ==> (r1 = r2)

    invariant table_41: forall (r: node, k: key, v: value)
        let n := (s.machines)[r] in
        ((n.table)[kv(k, v)]) ==> (n.owns)[k]

    invariant one_of_transfer_msg_or_owner_43: forall (e: event_list[node], r2: node) 
        let n2 := (s.machines)[r2] in
        let k := (e.payload).transfer_key in
        not (transfer_msg(s, e) and (n2.owns)[k])

    invariant unique_transfer_44: forall (e1: event_list[node], e2: event_list[node])
        let k1 := (e1.payload).transfer_key   in
        let k2 := (e2.payload).transfer_key   in
        (transfer_msg(s, e1) and transfer_msg(s, e2) and k1 = k2) ==> (e1 = e2)

    (* Translations from sharded_kv.invs *)
    (* Semantic mapping: *)
    (* - eTransfer.payload.key/value -> transfer_key/transfer_value *)
    (* - eTransfer.payload.dst/src -> e.target/e.source *)
    (* - eReshard.payload.key/value/dst -> reshard_key/reshard_value/reshard_to *)
    (* - eOwns(node, key, value) -> node state with owns[key]=true and table[kv(key,value)]=true *)
    (* - indexof(e) -> event ordering (dropping where needed) *)

    (* Original: ∀e0: eTransfer ∀e1: eReshard :: (e0.payload.value == e1.payload.value) -> (e0.payload.dst == e1.payload.dst) ∧ (indexof(e0) > indexof(e1)) ∧ (e0.payload.key == e1.payload.key) ∧ (e0.payload.src != e1.payload.dst) *)
    (* Translation: If transfer and reshard have same value, they have same key, same dst, and transfer target != reshard source (dropping indexof) *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_1: forall (e0: event_list[node], e1: event_list[node])
        let t_val := (e0.payload).transfer_value in
        let r_val := (e1.payload).reshard_value in
        let t_key := (e0.payload).transfer_key in
        let r_key := (e1.payload).reshard_key in
        let r_to := (e1.payload).reshard_to in
        (transfer_msg(s, e0) and (s.events)[e1] and e1 is send and e1.payload is eReshard and t_val = r_val) ==>
        (e0.target = r_to and t_key = r_key and e0.target != e1.source)
    *)

    (* Original: ∀e0: eTransfer ∀e1: eReshard :: (e0.payload.src == e1.payload.dst) -> (e0.payload.key != e1.payload.key) ∧ (e0.payload.dst != e1.payload.dst) *)
    (* Translation: If transfer source equals reshard destination, keys and destinations differ *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_2: forall (e0: event_list[node], e1: event_list[node])
        let t_key := (e0.payload).transfer_key in
        let r_key := (e1.payload).reshard_key in
        let r_to := (e1.payload).reshard_to in
        (transfer_msg(s, e0) and (s.events)[e1] and e1 is send and e1.payload is eReshard and e0.source = r_to) ==>
        (t_key != r_key and e0.target != r_to)
    *)

    (* Original: ∀e0: eTransfer ∀e1: eReshard :: (e0.payload.key == e1.payload.key) -> (e0.payload.dst == e1.payload.dst) ∧ (indexof(e0) > indexof(e1)) ∧ (e0.payload.value == e1.payload.value) ∧ (e0.payload.src != e1.payload.dst) *)
    (* Translation: If same key, then same dst, same value, and transfer target != reshard source (dropping indexof) *)
    (* This invariant causes the verifier to timeout *)
    invariant inv_3: forall (e0: event_list[node], e1: event_list[node])
        let t_key := (e0.payload).transfer_key in
        let t_val := (e0.payload).transfer_value in
        let r_key := (e1.payload).reshard_key in
        let r_val := (e1.payload).reshard_value in
        let r_to := (e1.payload).reshard_to in
        (transfer_msg(s, e0) and (s.events)[e1] and e1 is send and e1.payload is eReshard and t_key = r_key) ==>
        (e0.target = r_to and t_val = r_val and e0.target != e1.source)

    (* Original: ∀e0: eTransfer ∀e1: eReshard :: (indexof(e0) < indexof(e1)) ∧ (e0.payload.dst == e1.payload.dst) -> (e0.payload.key != e1.payload.key) ∧ (e0.payload.src != e1.payload.dst) *)
    (* Translation: If transfer dst equals reshard dst, then keys differ and transfer target != reshard source (dropping indexof ordering) *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_4: forall (e0: event_list[node], e1: event_list[node])
        let t_key := (e0.payload).transfer_key in
        let r_key := (e1.payload).reshard_key in
        let r_to := (e1.payload).reshard_to in
        (transfer_msg(s, e0) and (s.events)[e1] and e1 is send and e1.payload is eReshard and e0.target = r_to) ==>
        (t_key != r_key and e0.target != e1.source)
    *)

    (* Original: ∀e0: eTransfer :: ∃e1: eReshard :: (e0.payload.key != e1.payload.key) *)
    (* Translation: For every transfer, there exists a reshard with different key *)
    (* This is a weak property - skipping as it doesn't add meaningful constraint *)

    (* Original: ∀e0: eTransfer :: ∃e1: eReshard :: (indexof(e0) > indexof(e1)) ∧ (e0.payload.dst == e1.payload.dst) ∧ (e0.payload.key == e1.payload.key) ∧ (e0.payload.value == e1.payload.value) *)
    (* Translation: Every transfer was preceded by a reshard with same key, value, dst *)
    (* Cannot express indexof ordering, but we can express existence *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_6: forall (e0: event_list[node])
        let t_key := (e0.payload).transfer_key in
        let t_val := (e0.payload).transfer_value in
        (transfer_msg(s, e0)) ==>
        (exists (e1: event_list[node])
            let r_key := (e1.payload).reshard_key in
            let r_val := (e1.payload).reshard_value in
            let r_to := (e1.payload).reshard_to in
            (s.events)[e1] and e1 is send and e1.payload is eReshard and
            e0.target = r_to and t_key = r_key and t_val = r_val)
    *)

    (* Original: ∀e0: eTransfer ∀e1: eTransfer :: (e0.payload.src == e1.payload.dst) -> (e0.payload.src != e1.payload.src) ∧ (e0.payload.key != e1.payload.key) ∧ (e0.payload.dst != e1.payload.dst) *)
    (* Translation: If one transfer's source equals another's destination, they have different keys and both src/dst differ *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_7: forall (e0: event_list[node], e1: event_list[node])
        let k0 := (e0.payload).transfer_key in
        let k1 := (e1.payload).transfer_key in
        (transfer_msg(s, e0) and transfer_msg(s, e1) and e0.source = e1.target) ==>
        (e0.source != e1.source and k0 != k1 and e0.target != e1.target)
    *)

    (* Original: ∀e0: eTransfer ∀e1: eTransfer :: (e0.payload.dst == e1.payload.src) -> (e0.payload.src != e1.payload.src) ∧ (e0.payload.key != e1.payload.key) ∧ (e0.payload.dst != e1.payload.dst) *)
    (* Translation: If one transfer's destination equals another's source, they have different keys and both src/dst differ *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_8: forall (e0: event_list[node], e1: event_list[node])
        let k0 := (e0.payload).transfer_key in
        let k1 := (e1.payload).transfer_key in
        (transfer_msg(s, e0) and transfer_msg(s, e1) and e0.target = e1.source) ==>
        (e0.source != e1.source and k0 != k1 and e0.target != e1.target)
    *)

    (* Original: ∀e0: eTransfer ∀e1: eTransfer :: (e0.payload.key == e1.payload.key) -> (e0.payload.dst == e1.payload.dst) ∧ (indexof(e0) == indexof(e1)) ∧ (e0.payload.value == e1.payload.value) ∧ (e0.payload.dst != e1.payload.src) ∧ (e0.payload.src == e1.payload.src) ∧ (e0.payload.src != e1.payload.dst) *)
    (* Translation: Transfers with same key are identical events (dropping indexof) *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_9: forall (e0: event_list[node], e1: event_list[node])
        let k0 := (e0.payload).transfer_key in
        let k1 := (e1.payload).transfer_key in
        let v0 := (e0.payload).transfer_value in
        let v1 := (e1.payload).transfer_value in
        (transfer_msg(s, e0) and transfer_msg(s, e1) and k0 = k1) ==>
        (e0.target = e1.target and v0 = v1 and e0.target != e1.source and
         e0.source = e1.source and e0.source != e1.target)
    *)

    (* Original: ∀e0: eTransfer ∀e1: eTransfer :: (e0.payload.src == e1.payload.src) -> (e0.payload.dst != e1.payload.src) ∧ (e0.payload.src != e1.payload.dst) *)
    (* Translation: Transfers from same source have destinations not equal to sources *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_10: forall (e0: event_list[node], e1: event_list[node])
        (transfer_msg(s, e0) and transfer_msg(s, e1) and e0.source = e1.source) ==>
        (e0.target != e1.source and e0.source != e1.target)
    *)

    (* Original: ∀e0: eTransfer ∀e1: eTransfer :: (e0.payload.dst == e1.payload.dst) -> (e0.payload.dst != e1.payload.src) ∧ (e0.payload.src != e1.payload.dst) *)
    (* Translation: Transfers to same destination have sources not equal to destinations *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_11: forall (e0: event_list[node], e1: event_list[node])
        (transfer_msg(s, e0) and transfer_msg(s, e1) and e0.target = e1.target) ==>
        (e0.target != e1.source and e0.source != e1.target)
    *)

    (* Original: ∀e0: eTransfer ∀e1: eTransfer :: (e0.payload.value == e1.payload.value) -> (e0.payload.dst == e1.payload.dst) ∧ (indexof(e0) == indexof(e1)) ∧ (e0.payload.key == e1.payload.key) ∧ (e0.payload.dst != e1.payload.src) ∧ (e0.payload.src == e1.payload.src) ∧ (e0.payload.src != e1.payload.dst) *)
    (* Translation: Transfers with same value are identical (dropping indexof) *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_12: forall (e0: event_list[node], e1: event_list[node])
        let k0 := (e0.payload).transfer_key in
        let k1 := (e1.payload).transfer_key in
        let v0 := (e0.payload).transfer_value in
        let v1 := (e1.payload).transfer_value in
        (transfer_msg(s, e0) and transfer_msg(s, e1) and v0 = v1) ==>
        (e0.target = e1.target and k0 = k1 and e0.target != e1.source and
         e0.source = e1.source and e0.source != e1.target)
    *)

    (* Original: ∀e0: eOwns ∀e1: eTransfer :: (e0.payload.key == e1.payload.key) -> (indexof(e0) > indexof(e1)) ∧ (e0.payload.value == e1.payload.value) ∧ (e0.payload.node != e1.payload.src) ∧ (e0.payload.node == e1.payload.dst) *)
    (* Translation: If node owns key with value, no transfer with that key is pending (dropping indexof) *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_13: forall (r: node, k: key, v: value, e: event_list[node])
        let n := (s.machines)[r] in
        let t_key := (e.payload).transfer_key in
        let t_val := (e.payload).transfer_value in
        ((n.owns)[k] and (n.table)[kv(k, v)] and transfer_msg(s, e) and t_key = k) ==>
        (t_val = v and r != e.source and r = e.target)
    *)

    (* Original: ∀e0: eOwns ∀e1: eTransfer :: (e0.payload.value == e1.payload.value) -> (indexof(e0) > indexof(e1)) ∧ (e0.payload.key == e1.payload.key) ∧ (e0.payload.node != e1.payload.src) ∧ (e0.payload.node == e1.payload.dst) *)
    (* Translation: Similar to inv_13, using value as key *)
    (* This invariant causes the verifier to timeout *)
    (*
    invariant inv_14: forall (r: node, k: key, v: value, e: event_list[node])
        let n := (s.machines)[r] in
        let t_key := (e.payload).transfer_key in
        let t_val := (e.payload).transfer_value in
        ((n.owns)[k] and (n.table)[kv(k, v)] and transfer_msg(s, e) and t_val = v) ==>
        (t_key = k and r != e.source and r = e.target)
    *)

    (* Original: ∀e0: eOwns ∀e1: eTransfer :: (e0.payload.node == e1.payload.src) -> (e0.payload.key != e1.payload.key) ∧ (e0.payload.node != e1.payload.dst) *)
    (* Translation: If node owns a key, no transfer from that node for that key *)
    (* This invariant causes the verifier to timeout *)

    (* invariant inv_15: forall (r: node, k: key, e: event_list[node])
        let n := (s.machines)[r] in
        let t_key := (e.payload).transfer_key in
        ((n.owns)[k] and transfer_msg(s, e) and r = e.source) ==>
        (k != t_key and r != e.target) *)


    (* Original: ∀e0: eOwns ∀e1: eTransfer :: (indexof(e0) < indexof(e1)) ∧ (e0.payload.node == e1.payload.dst) -> (e0.payload.key != e1.payload.key) ∧ (e0.payload.node != e1.payload.src) *)
    (* Translation: If node owns key and is destination of transfer, keys differ (dropping indexof) *)
    (* This invariant causes the verifier to timeout *)
    (* invariant inv_16: forall (r: node, k: key, e: event_list[node])
        let n := (s.machines)[r] in
        let t_key := (e.payload).transfer_key in
        ((n.owns)[k] and transfer_msg(s, e) and r = e.target) ==>
        (k != t_key and r != e.source) *)

    (* Original: ∀e0: eOwns :: ∃e1: eTransfer :: (e0.payload.key != e1.payload.key) *)
    (* Translation: Weak property, skipping *)

    (* Original: ∀e0: eOwns ∀e1: eOwns :: (e0.payload.key == e1.payload.key) -> (e0.payload.value == e1.payload.value) ∧ (e0.payload.node == e1.payload.node) *)
    (* Translation: Same key implies same value and same node *)
    (* This invariant causes the verifier to timeout *)
    invariant inv_18: forall (r1: node, r2: node, k: key, v1: value, v2: value)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        ((n1.owns)[k] and (n1.table)[kv(k, v1)] and
         (n2.owns)[k] and (n2.table)[kv(k, v2)]) ==>
        (v1 = v2 and r1 = r2)

    (* Original: ∀e0: eOwns ∀e1: eOwns :: (e0.payload.value == e1.payload.value) -> (e0.payload.key == e1.payload.key) ∧ (e0.payload.node == e1.payload.node) *)
    (* Translation: Same value implies same key and same node *)
    (* invariant inv_19: forall (r1: node, r2: node, k1: key, k2: key, v: value)
        let n1 := (s.machines)[r1] in
        let n2 := (s.machines)[r2] in
        ((n1.owns)[k1] and (n1.table)[kv(k1, v)] and
         (n2.owns)[k2] and (n2.table)[kv(k2, v)]) ==>
        (k1 = k2 and r1 = r2) *)

